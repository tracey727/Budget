# Local development secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to `.dev.vars` (git-ignored) and fill in. Never commit real values.

# Neon Postgres — the POOLED connection string from the Neon console.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/genevieve?sslmode=require"

# 32+ random bytes. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"

# Stripe — use test keys locally (sk_test_...).
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Public origin, used for redirects and Stripe return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email — password reset delivery via Resend (https://resend.com).
# Without this, reset links are logged to the console instead of sent.
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Genevieve App <noreply@genevieveapp.com.au>"

# ---------------------------------------------------------------------------
# Open banking (optional)
# ---------------------------------------------------------------------------
# Without these the app connects a built-in demo bank instead: realistic
# Australian transactions that arrive pending and settle about a day later, so
# the whole pending/cleared flow can be seen before signing a CDR agreement.
#
# For real accounts, sign up as a Basiq partner (https://basiq.io), which holds
# the Consumer Data Right accreditation. The key is the base64 value Basiq
# shows under Developer Dashboard -> Applications.
BASIQ_API_KEY=""
# Shared secret for verifying Basiq webhook deliveries (HMAC-SHA256, hex).
BASIQ_WEBHOOK_SECRET=""

# Shared secret for the scheduled sync endpoint, POST /api/cron/sync.
# Generate with: openssl rand -hex 32
# Without it, scheduled syncing is disabled and returns 503.
CRON_SECRET=""
